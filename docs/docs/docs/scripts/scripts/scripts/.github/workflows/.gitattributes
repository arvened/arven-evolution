# Auto detect text files and normalize line endings
* text=auto

# Source code
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar binary
*.gz binary

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf

# Git config
.gitignore text eol=lf
.gitattributes text eol=lf

# Node
package.json text eol=lf
package-lock.json text eol=lf
pnpm-lock.yaml text eol=lf

# TypeScript
tsconfig.json text eol=lf

# Environment
.env* text eol=lf

# Scripts
scripts/*.sh text eol=lf
*.sh text eol=lf eol=crlf
