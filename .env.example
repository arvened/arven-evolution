NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://arven:secure_password@localhost:5432/arven_evolution
DB_HOST=postgres
DB_PORT=5432
DB_USER=arven
DB_PASSWORD=secure_password
DB_NAME=arven_evolution

REDIS_URL=redis://localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secure_password

REVIEWER_WEBHOOK_URL=http://localhost:3000/api/audit/webhook-callback
WEBHOOK_SECRET=your-super-secret-webhook-key-change-this

SECURITY_API_PORT=3001
PARTNER_API_PORT=3002

CORS_ORIGIN=*

LOG_LEVEL=info

JWT_SECRET=your-jwt-secret-key-change-this
API_KEY=your-api-key-change-this

SENTRY_DSN=https://your-sentry-url
DATADOG_API_KEY=your-datadog-api-key

FEATURE_SECURITY_MODULE=true
FEATURE_PARTNER_REVENUE=true
FEATURE_WEBHOOK_RETRY=true

DB_POOL_SIZE=20
CACHE_TTL_SECONDS=3600
API_RATE_LIMIT=1000

BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
