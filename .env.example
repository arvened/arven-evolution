# Copy to .env and fill in. Never commit .env.

PORT=3000

# Strongly recommended: when set, every /api/* request needs "Authorization: Bearer <value>".
ARVEN_API_KEY=

# Document review (optional). Point to a config file created from fusion.config.example.json:
# FUSION_CONFIG_FILE=/app/fusion.config.json

# API keys referenced by "apiKeyEnv" in the fusion config:
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
